# Airflow runtime artifacts (regenerated by docker compose on every run)
logs/*
!logs/.gitkeep

# Students' scratch work while doing the exercises
ejercicios/sandbox/*
!ejercicios/sandbox/.gitkeep

# Python
__pycache__/
*.pyc

# Local environment overrides (keep the tracked .env as the shared template)
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
