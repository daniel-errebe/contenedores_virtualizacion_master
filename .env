# ---------------------------------------------------------------------------
# Environment variables consumed by docker-compose.yml
#
# These values are safe, well-known defaults meant for a LOCAL, isolated
# teaching environment only. Never reuse them in production, and never
# expose these ports/services beyond localhost.
# ---------------------------------------------------------------------------

# Airflow image: Airflow 3.3.1 built on Python 3.14
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1-python3.14

# UID Airflow runs as inside the containers.
# On Linux, set this to your host user id (run `id -u`) so files written to
# ./dags, ./logs and ./plugins are owned by you instead of root.
# On macOS/Windows with Docker Desktop this can be left as-is.
AIRFLOW_UID=50000

# Host port used to reach the Airflow UI/API (bound to 127.0.0.1 only)
AIRFLOW_PORT=8080

# PostgreSQL metadata database credentials
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
